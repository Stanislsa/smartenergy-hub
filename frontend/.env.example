# Configuration du frontend SmartEnergy Hub
# Copiez ce fichier en .env.local et ajustez les valeurs selon votre environnement

# URL de base de l'API (proxy Vite en développement)
# En production, cette variable peut être utilisée pour pointer directement sur les services
VITE_API_BASE_URL=http://localhost:5173

# URLs des services backend (optionnel, utilisé si le proxy n'est pas configuré)
# VITE_COLLECTOR_URL=http://localhost:8081
# VITE_STORAGE_URL=http://localhost:8082
# VITE_ANALYTICS_URL=http://localhost:8083
# VITE_AI_SERVICE_URL=http://localhost:8085

# Configuration de l'environnement
VITE_ENV=development

# Intervalle de rafraîchissement des health checks (en millisecondes)
VITE_SERVICES_CHECK_INTERVAL=30000

# Limite de mesures chargées par défaut (pagination client)
VITE_DEFAULT_MEASUREMENTS_LIMIT=5000

# Activation du mode debug (logs supplémentaires dans la console)
VITE_DEBUG=false

# Fuseau horaire par défaut pour l'affichage des dates
VITE_TIMEZONE=Europe/Paris
